# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Neon (PostgreSQL) ────────────────────────────────────────────────────────
# Get this from: https://console.neon.tech → your project → Connection Details
# Use the "pooled" connection string (port 5432 via PgBouncer) for app use.
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── Upstash (Redis) ──────────────────────────────────────────────────────────
# Get these from: https://console.upstash.com → your Redis DB → REST API section
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-64-characters-long"
JWT_EXPIRES_IN="7d"

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# ─── Geo Enrichment Providers (real, free, HTTPS) ─────────────────────────────
# No API keys needed. Fallback chain: ipwho.is → ipapi.co → freeipapi.com
# GEO_TIMEOUT_MS: per-provider HTTP timeout in milliseconds (default: 3000)
GEO_TIMEOUT_MS=3000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── CORS (Cross-Origin Dashboard) ───────────────────────────────────────────
# Only required when the dashboard is deployed to a DIFFERENT domain than the
# backend. Leave blank for same-domain deployments.
# Must be the exact origin (scheme + host + optional port, no trailing slash).
# Example: DASHBOARD_ORIGIN=https://my-dashboard.vercel.app
DASHBOARD_ORIGIN=
